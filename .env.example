# Copy to .env.local for local development. Locally everything is optional: with no DATABASE_URL a
# SQLite file (local.db) is used. In production (Vercel) DATABASE_URL, AUTH_SECRET and
# NEXT_PUBLIC_SITE_URL are required.

# Postgres on Neon: the POOLED connection string (host contains "-pooler"), with sslmode=require.
# Production only uses Postgres; a deploy without it has no accounts rather than a throwaway database.
DATABASE_URL=

# Signs session cookies. Required in production: a random string of at least 32 characters
# (e.g. `openssl rand -base64 48`). Changing it signs everyone out.
AUTH_SECRET=

# The public URL of the site (e.g. https://ascend.example): sitemap, robots.txt, link previews, and the
# links in password-reset emails (required for those in production).
NEXT_PUBLIC_SITE_URL=

# Password reset by email, through Resend (https://resend.com). Both unset: reset by email is off and the
# reset pages say so. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Ascend <no-reply@example.com>"

# Local development only: where the SQLite file lives (default ./local.db).
SQLITE_PATH=

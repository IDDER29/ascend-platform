# Copy to .env.local and fill in. Everything is optional for local development.

# Postgres connection string (Supabase works as-is). Unset: a local SQLite file (local.db) is used.
DATABASE_URL=

# Secret for signing session cookies. Required in production; dev falls back to an insecure default.
AUTH_SECRET=

# The public URL of the site, for the sitemap, robots.txt and link previews (e.g. https://ascend.example).
NEXT_PUBLIC_SITE_URL=

# Where the local SQLite file lives (default ./local.db).
SQLITE_PATH=
